# ==============================================================================
# Rotaract Club of SLTC Website - Environment Variables
# ==============================================================================

# MongoDB Connection String (Atlas Cluster URI or Local MongoDB)
# Example for Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/rac_sltc?retryWrites=true&w=majority
# Example for Local: mongodb://localhost:27017/rac_sltc
MONGODB_URI=mongodb://localhost:27017/rac_sltc

# Cloudinary Storage for Project Images and Media (Optional for direct URLs)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Primary Administrator Credentials & Cryptographic Secrets
ADMIN_EMAIL=rotaractsltc@gmail.com
ADMIN_PASSCODE=admin123
PROJECT_PASSCODE=project123
ADMIN_SESSION_SECRET=rotaract_sltc_secure_session_secret_hmac_2026_xyz987

# SMTP Email Dispatcher (Optional: Gmail or Google Workspace App Password)
# If left blank, OTPs will be displayed in the server terminal during development
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=rotaractsltc@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM="Rotaract Club of SLTC" <rotaractsltc@gmail.com>


# Web Push Notification VAPID Keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_public_vapid_key
VAPID_PRIVATE_KEY=your_private_vapid_key
VAPID_SUBJECT=mailto:rotaractsltc@gmail.com
