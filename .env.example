# ==============================================================================
# Rotaract Club of SLTC Website - Environment Variables
# ==============================================================================

# MongoDB Connection String (Atlas Cluster URI or Local MongoDB)
# Example for Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/rac_sltc?retryWrites=true&w=majority
# Example for Local: mongodb://localhost:27017/rac_sltc
MONGODB_URI=mongodb://localhost:27017/rac_sltc

# Cloudinary Storage for Project Images and Media (Optional for direct URLs)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
